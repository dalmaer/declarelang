/*
# The tickets

What someone holds up at the door with a queue behind them: one ticket at a time,
large, with the performance, the seat, when to arrive, and a code to scan. The
tickets sit side by side on one strip; `pos` is a spring that slides the strip to
the one being shown, so stepping through them is a single motion, interruptible.
*/

class NextIcon extends ChevronIcon [ dir = "right" ]

class Barcode [ height = 76,
    code: string = "",
    accessibilityRole = image,
    accessibilityLabel = { "Barcode " + code },
    draw(d: Draw) {
        const bars = code128(this.code)
        const modules = bars.reduce((n, w) => n + w, 0) + 20        // ten modules of quiet space each side
        const m = this.width / modules
        let x = 10 * m
        d.fillStyle = provided("theme").ticketInk
        bars.forEach((w, i) => {
            if (i % 2 == 0) d.fillRect(Math.round(x * 2) / 2, 0, Math.max(1, w * m), this.height)
            x = x + w * m
            })
        }
    ]


class Stub [
    label: string = "",
    value: string = "",
    layout: SimpleLayout [ axis = y, spacing = 2 ],
    Text [ fontSize = 11, fontWeight = semibold, letterSpacing = 1.4, textTransform = uppercase, wrap = false,
        textColor = { provided("theme").textMuted }, text = { classroot.label } ],
    Text [ fontFamily = { app.serifFace }, fontSize = { app.compact ? 28 : 34 }, wrap = false, numerals = lining, text = { classroot.value } ]
    ]


class TicketCard [
    accessibilityRole = group,
    nth: number = { rowIndex + 1 },
    accessibilityLabel = { "Ticket " + nth + " of " + app.ticketCount() + ": " + :section + ", row " + :row + ", seat " + :number },
    width = { provided("ticketW") },
    x = { (rowIndex - app.tix.pos) * (width + 24) },
    visible = { Math.abs(rowIndex - app.tix.pos) < 1 },
    perf: Performance? = { app.production.byId(app.result?.performanceId ?? "") },
    cornerRadius = 18, fill = { provided("theme").ticketPaper },
    stroke = { stroke(1, provided("theme").line) },
    layout: SimpleLayout [ axis = y ],

    head: View [ width = 100%, padding = [22, 24, 18, 24], cornerRadius = [18, 18, 0, 0], fill = { provided("theme").stage },
        layout: SimpleLayout [ axis = y, spacing = 2 ],
        Text [ width = 100%, fontFamily = { app.serifFace }, fontSize = 24, textColor = { provided("theme").stageText },
            text = { app.production.value?.title ?? "" } ],
        Text [ fontSize = 12, letterSpacing = 1.4, textTransform = uppercase, textColor = { provided("theme").textFaint },
            text = { (app.production.value?.hall ?? "") + " · Ticket " + classroot.nth + " of " + app.ticketCount() } ]
        ],
    when: View [ width = 100%, padding = [20, 24, 4, 24],
        layout: SimpleLayout [ axis = y, spacing = 4 ],
        Text [ fontFamily = { app.serifFace }, fontSize = 30, wrap = false,
            text = { classroot.perf == null ? "" : dayLabel(classroot.perf.startsAt) + " · " + timeLabel(classroot.perf.startsAt) } ],
        Text [ width = 100%, fontSize = 15, fontWeight = semibold,
            text = { classroot.perf == null ? "" : "Doors open " + timeLabel(classroot.perf.doorsAt) + " — please arrive by then" } ]
        ],
    seat: View [ width = 100%, padding = [16, 24, 20, 24],
        layout: SimpleLayout [ axis = x, spacing = 22 ],
        Stub [ label = "Section", value = :section ],
        Stub [ label = "Row", value = :row ],
        Stub [ label = "Seat", value = { "" + :number } ]
        ],

    // the tear between the ticket and its stub

    tear: View [ width = 100%, height = 18,
        draw(d: Draw) {
            d.strokeStyle = provided("theme").lineStrong
            d.lineWidth = 1.5
            d.setLineDash([5, 6])
            d.beginPath()
            d.moveTo(14, 9); d.lineTo(this.width - 14, 9)
            d.stroke()
            }
        ],
    scan: View [ width = 100%, padding = [6, 24, 22, 24],
        layout: SimpleLayout [ axis = y, spacing = 8, align = center ],
        Barcode [ width = 100%, code = :barcode ],
        Text [ fontSize = 15, letterSpacing = 2, numeralWidth = tabular, wrap = false, text = :barcode ]
        ]
    ]


class TicketsPage [
    padding = { app.compact ? [24, 16, 40, 16] : [44, 32, 64, 32] },
    col: View [ x = center, width = { Math.min(440, parent.width - (app.compact ? 32 : 64)) },
        ticketW: number = { this.width },
        layout: SimpleLayout [ axis = y, spacing = 16 ],

        Text [ accessibilityRole = heading, accessibilityLevel = 1, fontFamily = { app.serifFace }, fontSize = { app.compact ? 30 : 36 },
            text = { "Your " + (app.ticketCount() == 1 ? "ticket" : app.ticketCount() + " tickets") } ],
        sent: View [ width = 100%,
            layout: SimpleLayout [ axis = y, spacing = 4 ],
            Text [ fontSize = 17, fontWeight = semibold, text = { "Sent to " + (app.result?.email ?? "") } ],
            Text [ width = 100%, fontSize = 14, textColor = { provided("theme").textMuted },
                text = { "Confirmation " + (app.result?.code ?? "") + " · " + money(app.result?.totalCents ?? 0) + " paid with "
                         + brandName(app.result?.brand ?? "") + " ending " + (app.result?.last4 ?? "") } ]
            ],

        // the strip: one ticket in view, the rest beside it, out of frame

        strip: View [ width = 100%, clip = true,
            datapath = { app.result },
            focusable = true,
            accessibilityRole = region, accessibilityLabel = "Tickets",
            onKeyDown(e: KeyEvent) {
                if (e.key == "ArrowRight") app.tix.go(1)
                else if (e.key == "ArrowLeft") app.tix.go(-1)
                },
            onPointerUp(e: PointerUpEvent) {
                if (!e.canceled && Math.abs(e.deltaX) > 40 && Math.abs(e.deltaX) > Math.abs(e.deltaY)) app.tix.go(e.deltaX < 0 ? 1 : -1)
                },
            onPointerMove(e: PointerEvent) { },
            claim = y,
            TicketCard [ datapath = :tickets[], key = :seatId ]
            ],

        pager: View [ x = center, visible = { app.ticketCount() > 1 },
            layout: SimpleLayout [ axis = x, spacing = 14, align = center ],
            Button [ label = { app.compact ? "Previous" : "Previous ticket" }, accessibilityLabel = "Previous ticket", iconLeft = "BackIcon", iconSize = 14, disabled = { app.tix.at == 0 },
                onClick() { app.tix.go(-1) }
                ],
            Text [ fontSize = 15, numeralWidth = tabular, wrap = false, accessibilityLive = polite,
                text = { (app.tix.at + 1) + " of " + app.ticketCount() } ],
            Button [ label = { app.compact ? "Next" : "Next ticket" }, accessibilityLabel = "Next ticket", iconSize = 14, iconRight = "NextIcon", disabled = { app.tix.at >= app.ticketCount() - 1 },
                onClick() { app.tix.go(1) }
                ]
            ],
        Divider [ ],
        Button [ x = center, label = "Book another performance",
            onClick() { app.startAgain() }
            ]
        ]
    ]


// which ticket is shown, and the spring that carries the strip to it

class TicketPager extends Node [
    at: number = 0,
    pos: number = 0,
    slide: Spring [ attribute = pos, to = { classroot.at }, stiffness = 260, damping = 30 ],
    go(d: number) { this.at = Math.max(0, Math.min(app.ticketCount() - 1, this.at + d)) }
    ]
