/*
## Faces

A person is their photograph where they have one, and their initials on their
own ink where they don't — the same ink their name wears in a group.
*/

class Avatar [ cornerRadius = { size / 2 }, clip = true,
    person: string = "",
    size: number = 40,
    width = { size }, height = { size },
    who: Person? = { app.convos.person(person) },
    fill = { app.inkOf(person) },
    letters: Text [ x = center, y = center, fontSize = { classroot.size * 0.38 }, fontWeight = semibold,
        textColor = { provided("theme").onInk }, text = { initials(classroot.who?.name ?? "") },
        visible = { !(classroot.photo?.loaded ?? false) } ],
    photo: Image [ exists = { classroot.who?.avatar != null }, width = 100%, height = 100%, stretches = cover,
        source = { app.media(classroot.who?.avatar ?? "") } ]
    ]


// a conversation's face: the other person, or two of a group's people overlapping

class ThreadFace [
    thread: Thread? = null,
    size: number = 48,
    width = { size }, height = { size },
    others: string[] = { thread == null ? [] : app.convos.others(thread) },
    solo: Avatar [ exists = { classroot.others.length == 1 }, person = { classroot.others[0] ?? "" }, size = { classroot.size } ],
    back: Avatar [ exists = { classroot.others.length > 1 }, person = { classroot.others[1] ?? "" },
        size = { Math.round(classroot.size * 0.68) }, x = { classroot.size - this.width }, y = 0 ],
    front: Avatar [ exists = { classroot.others.length > 1 }, person = { classroot.others[0] ?? "" },
        size = { Math.round(classroot.size * 0.68) }, x = 0, y = { classroot.size - this.height },
        stroke = { stroke(2, provided("theme").ring) } ]
    ]


/*
## The conversation list

Most recent first, always — the list is derived from the threads, so a message
arriving anywhere re-sorts it, and each row slides to its new place rather than
jumping, so the eye can follow the conversation that moved. New is vermilion and
nothing else is: the count, the time, the weight of the name.
*/

class InboxRow extends Control [ width = 100%, padding = [11, 16, 11, 14],
    t: Thread = { :thread },
    unread: number = { :unread },
    last: Message = { :last },
    typists: string[] = { app.convos.typists(:id) },
    selected: boolean = { :id == app.openId && !app.phone },

    fill = { selected ? provided("theme").rowSelected : pressed || hovered ? provided("theme").rowPressed : null },
    cornerRadius = { app.phone ? 0 : 12 },
    layout: SimpleLayout [ axis = x, spacing = 12, align = center ],

    face: ThreadFace [ thread = { classroot.t }, size = 50 ],
    words: View [ flexes = true,
        layout: SimpleLayout [ axis = y, spacing = 2 ],
        top: View [ width = 100%,
            layout: SimpleLayout [ axis = x, spacing = 8, align = baseline ],
            name: Text [ flexes = true, maxLines = 1, fontSize = 16, letterSpacing = -0.1,
                fontWeight = { classroot.unread > 0 ? "bold" : "semibold" },
                textColor = { provided("theme").text }, text = { app.convos.titleOf(classroot.t) } ],
            when: Text [ fontSize = 12.5, numeralWidth = tabular, maxLines = 1,
                fontWeight = { classroot.unread > 0 ? "semibold" : "regular" },
                textColor = { classroot.unread > 0 ? provided("theme").fresh : provided("theme").textMuted },
                text = { listStamp(classroot.last.at, app.clock.now) } ]
            ],
        bottom: View [ width = 100%,
            layout: SimpleLayout [ axis = x, spacing = 10, align = center ],
            preview: Text [ flexes = true, maxLines = 2, fontSize = 14, lineHeight = 1.3,
                italic = { classroot.typists.length > 0 },
                textColor = { classroot.typists.length > 0 ? provided("theme").accent
                    : classroot.unread > 0 ? provided("theme").text : provided("theme").textMuted },
                text = { classroot.typists.length > 0
                    ? app.typingLine(classroot.t, classroot.typists)
                    : app.preview(classroot.t, classroot.last) } ],
            badge: CountBadge [ exists = { classroot.unread > 0 }, count = { classroot.unread } ]
            ]
        ],

    press() { app.openThread(:id) }
    ]


class CountBadge [ height = 20, cornerRadius = 10, padding = [0, 6, 0, 6],
    count: number = 0,
    width = { Math.max(20, this.n.width + 12) },
    fill = { provided("theme").fresh },
    n: Text [ x = center, y = center, fontSize = 12, fontWeight = bold, numeralWidth = tabular,
        textColor = { provided("theme").freshText }, text = { classroot.count > 99 ? "99+" : "" + classroot.count } ]
    ]


/*
## A conversation

Header, history, composer. There is one of these per thread, built once and
kept: only the open one is shown, so each keeps its own scroll position and its
own unsent draft without either being saved anywhere. The history reads from
the bottom (`scrollAnchor = end`): at the newest message it follows what
arrives; scrolled back, the words under the reader stay put and a pill says
what is waiting below.
*/

class ConversationView [ width = 100%, height = 100%,
    thread: Thread = { :@ },
    threadId: string = { :id },
    open: boolean = { :id == app.openId },
    visible = { open },

    // provided to every message row

    msgs: Message[] = { :messages ?? [] },
    group: boolean = { app.convos.isGroup(thread) },

    // on a wide screen the conversation is a reading column, not the width of the window:
    // what you said and what they said stay within one glance of each other

    columnW: number = { Math.min(this.width, 800) },
    bubbleMax: number = { Math.min(Math.round(this.columnW * (app.phone ? 0.8 : 0.72)), 540) },
    readTop: number = { this.body.history.scrollY + 12 },

    draft: string = "",
    typists: string[] = { app.convos.typists(:id) },
    unread: number = { app.convos.unread(thread) },
    newest: Message? = { msgs.length > 0 ? msgs[msgs.length - 1] : null },

    // at the newest message, the conversation counts as read

    fromEnd: number = { this.body.history.contentHeight - this.body.history.scrollY - this.body.history.height },
    atEnd: boolean = { fromEnd < 56 },
    seeing: boolean = { open && atEnd && app.convoShown && app.pageVisible },
    newestId: string = { newest?.id ?? "" },
    trackChanges = ["seeing", "newestId", "open"],
    onChange(e: ChangeEvent) {
        if (seeing) app.convos.markSeen(threadId)
        for (const c of e.changed) {
            // whatever you send, you see arrive — even sent from far back in the history
            if (c.name == "newestId" && (newest?.pending ?? false)) toEnd()
            // on a keyboard-and-pointer screen, opening a conversation is opening it to write
            if (c.name == "open" && open && !app.touchDevice) afterSettle(() => Focus.focus(this.composer.entry))
            }
        },

    send() {
        const text = draft.trim()
        if (text == "") return
        draft = ""
        app.wire.sendText(threadId, text)
        },
    toEnd() { this.body.history.scrollTo(Infinity, ({ duration: 260 })) },

    layout: SimpleLayout [ axis = y ],

    header: ConvoHeader [ thread = { classroot.thread }, typists = { classroot.typists } ],

    body: View [ width = 100%, flexes = true,
        history: View [ width = 100%, height = 100%, scrolls = y, scrollAnchor = end,
            col: View [ x = center, width = { classroot.columnW }, padding = [6, 0, 14, 0],
                layout: SimpleLayout [ axis = y ],
                MessageRow [ datapath = :messages[], virtualize = true,
                    classFor = { :kind == "photo" ? PhotoRow : :kind == "voice" ? VoiceRow : TextRow } ],
                TypingRow [ exists = { classroot.typists.length > 0 }, typists = { classroot.typists },
                    group = { classroot.group } ]
                ]
            ],

        // while scrolling back, where in time the reader is

        when: WhenChip [ x = center, y = 10, threadId = { classroot.threadId },
            showing = { classroot.body.history.scrolling && classroot.fromEnd > 400 } ],

        // something arrived below the reader, or the reader is far from the newest

        below: BelowPill [ x = center, y = { parent.height - this.height - 12 },
            count = { classroot.atEnd ? 0 : classroot.unread },
            latest = { classroot.newest }, far = { classroot.fromEnd > 900 },
            press() { classroot.toEnd() }
            ]
        ],

    composer: Composer [ threadId = { classroot.threadId }, draft = { classroot.draft },
        side = { Math.max(10, (classroot.width - classroot.columnW) / 2 + 10) },
        input(v: string) { classroot.draft = v },
        submit() { classroot.send() }
        ]
    ]


class ConvoHeader [ width = 100%, height = { 60 + app.safeTop }, padding = { [app.safeTop, 12, 0, app.phone ? 4 : 18] },
    thread: Thread? = null,
    typists: string[] = [],
    fill = { provided("theme").background },
    stroke = { [null, null, stroke(1, provided("theme").line), null] },
    layout: SimpleLayout [ axis = x, spacing = 10, align = center ],

    back: BackButton [ exists = { app.phone },
        press() { app.closeThread() }
        ],
    face: ThreadFace [ thread = { classroot.thread }, size = 38 ],
    titles: View [ flexes = true,
        layout: SimpleLayout [ axis = y, spacing = 1 ],
        title: Text [ width = 100%, maxLines = 1, fontSize = 16.5, fontWeight = semibold, letterSpacing = -0.1,
            textColor = { provided("theme").text },
            text = { classroot.thread == null ? "" : app.convos.titleOf(classroot.thread) } ],
        sub: Text [ width = 100%, maxLines = 1, fontSize = 12.5,
            visible = { this.text != "" },
            textColor = { classroot.typists.length > 0 ? provided("theme").accent : provided("theme").textMuted },
            text = { classroot.thread == null ? ""
                : classroot.typists.length > 0 ? app.typingLine(classroot.thread, classroot.typists)
                : app.convos.isGroup(classroot.thread) ? app.memberLine(classroot.thread) : "" } ]
        ]
    ]


class BackButton extends Control [ width = 40, height = 40, cornerRadius = 20,
    fill = { pressed ? provided("theme").control : null },
    tooltipLabel = "Conversations",
    ChevronIcon [ x = center, y = center, dir = "left", iconSize = 22, weight = 2.2, ink = { provided("theme").accent } ]
    ]


// three dots breathing at the foot of the conversation while someone writes

class TypingRow [ width = 100%, padding = [8, 12, 0, 12],
    typists: string[] = [],
    group: boolean = false,
    phase: number = 0,
    Animator [ attribute = phase, from = 0, to = 1, duration = 1200, repeat = 100000, motion = linear, started = true ],
    layout: SimpleLayout [ axis = x, spacing = 6, align = end ],
    face: View [ exists = { classroot.group }, width = 30, height = 30,
        Avatar [ person = { classroot.typists[0] ?? "" }, size = 30 ]
        ],
    dots: View [ width = 58, height = 36, cornerRadius = 18,
        fill = { provided("theme").theirsFill }, stroke = { stroke(1, provided("theme").theirsEdge) },
        draw(d: Draw) {
            const t = classroot.phase
            for (let i = 0; i < 3; i++) {
                const k = Math.max(0, Math.sin((t - i * 0.16) * Math.PI * 2))
                d.globalAlpha = 0.3 + 0.6 * k
                d.fillStyle = provided("theme").textMuted
                d.beginPath()
                d.arc(17 + i * 12, 18 - 2.5 * k, 3.6, 0, Math.PI * 2, false)
                d.fill()
                }
            }
        ]
    ]


// the date under the reader's eye, shown only while they scroll back through time

class WhenChip [ height = 30, padding = [0, 14, 0, 14], cornerRadius = 15,
    threadId: string = "",
    showing: boolean = false,
    shown: number = 0,
    Spring [ attribute = shown, to = { classroot.showing ? 1 : 0 }, stiffness = { classroot.showing ? 300 : 60 }, damping = 26 ],
    visible = { shown > 0.01 },
    opacity = { shown },
    pointerEvents = "none",
    fill = { provided("theme").text },
    shadow = { provided("theme").popoverShadow },
    t: Text [ y = center, fontSize = 13, fontWeight = semibold, maxLines = 1,
        textColor = { provided("theme").background },
        text = { app.topAt(classroot.threadId) == "" ? "" : dayHeading(app.topAt(classroot.threadId), app.clock.now) } ]
    ]


// "3 new" with the newest one's first words — or, far back with nothing new, a way down

class BelowPill extends Control [ height = 36, cornerRadius = 18,
    count: number = 0,
    latest: Message? = null,
    far: boolean = false,
    fresh: boolean = { count > 0 },
    visible = { fresh || far },
    padding = { fresh ? [0, 16, 0, 12] : [0, 9, 0, 9] },
    fill = { fresh ? provided("theme").fresh : provided("theme").surface },
    stroke = { fresh ? null : stroke(1, provided("theme").line) },
    shadow = { provided("theme").popoverShadow },
    opacity = { pressed ? 0.85 : 1 },
    tooltipLabel = "Jump to the newest",
    layout: SimpleLayout [ axis = x, spacing = 8 ],
    ArrowIcon [ dir = "down", iconSize = 16, weight = 2,
        ink = { classroot.fresh ? provided("theme").freshText : provided("theme").accent } ],
    words: Text [ exists = { classroot.fresh }, y = center, maxLines = 1, fontSize = 13.5, fontWeight = semibold,
        width = { Math.min(Math.ceil(measureText(this.text, providedTextStyle(({ fontSize: 13.5, fontWeight: "semibold" }))).width) + 2,
                           app.width - 120) },
        textColor = { provided("theme").freshText },
        text = { app.belowLine(classroot.count, classroot.latest) } ]
    ]


/*
## Writing

A field that grows to five lines and then scrolls; Return sends, Shift-Return
breaks the line. The photograph button opens the service's photographs; the
send button wakes when there is something to send.
*/

class Composer [ width = 100%, padding = { [8, side, 8 + app.safeBottom, side] },
    side: number = 10,
    threadId: string = "",
    draft: string = "",
    input(v: string) { },
    submit() { },
    empty: boolean = { draft.trim() == "" },

    fill = { provided("theme").background },
    stroke = { [stroke(1, provided("theme").line), null, null, null] },
    layout: SimpleLayout [ axis = x, spacing = 8, align = end ],

    photo: RoundButton [ tooltipLabel = "Send a photograph",
        PhotoIcon [ x = center, y = center, iconSize = 22, ink = { provided("theme").accent } ],
        press() { app.pickPhoto(this) }
        ],

    // the field is its own chrome: the library's derived look yields to these

    entry: TextInput [ flexes = true, multiline = true, enterSubmits = true, wrap = true,
        cornerRadius = 20, padding = [10, 15, 10, 15], fontSize = 16, placeholder = "Message",
        fill = { provided("theme").fieldFill },
        stroke = { stroke(1, this.focused ? provided("theme").accent : provided("theme").fieldEdge) },
        textColor = { provided("theme").text },
        height = { 20 + 21 * Math.min(5, Math.max(1, measureText(classroot.draft == "" ? "x" : classroot.draft,
            providedTextStyle(({ fontSize: 16 })), this.width - 30).lines)) },
        text = { classroot.draft },
        onInput(v: string) { classroot.input(v) },
        onEnter() { classroot.submit() }
        ],

    send: RoundButton [ disabled = { classroot.empty }, tooltipLabel = "Send",
        fill = { this.disabled ? provided("theme").control : this.pressed ? provided("theme").accentPressed : provided("theme").accent },
        SendIcon [ x = center, y = center, iconSize = 20,
            ink = { classroot.empty ? provided("theme").textFaint : provided("theme").accentTextColor } ],
        press() { classroot.submit() }
        ]
    ]


class RoundButton extends Control [ width = 40, height = 40, cornerRadius = 20,
    fill = { pressed ? provided("theme").controlPressed : hovered ? provided("theme").control : null }
    ]


/*
## Drawn marks

The few marks the library does not carry, in its 16-box and its constant stroke.
*/

class SendIcon extends Icon [
    draw(d: Draw) {
        d.scale(unit, unit)
        d.strokeStyle = ink
        d.lineWidth = 2.1 / unit
        d.lineCap = "round"
        d.lineJoin = "round"
        d.beginPath()
        d.moveTo(8, 13.5); d.lineTo(8, 2.8)
        d.moveTo(3.4, 7.2); d.lineTo(8, 2.6); d.lineTo(12.6, 7.2)
        d.stroke()
        }
    ]


class PhotoIcon extends Icon [
    draw(d: Draw) {
        d.scale(unit, unit)
        d.strokeStyle = ink
        d.lineWidth = weight / unit
        d.lineJoin = "round"
        d.beginPath()
        d.roundRect(1.5, 3, 13, 10.5, 2.2)
        d.stroke()
        d.beginPath()
        d.moveTo(2, 12); d.lineTo(6, 8); d.lineTo(9, 11); d.lineTo(11, 9.2); d.lineTo(14, 12)
        d.stroke()
        d.beginPath()
        d.arc(11, 6.3, 1.2, 0, Math.PI * 2, false)
        d.stroke()
        }
    ]


class SmileIcon extends Icon [
    draw(d: Draw) {
        d.scale(unit, unit)
        d.strokeStyle = ink
        d.fillStyle = ink
        d.lineWidth = weight / unit
        d.lineCap = "round"
        d.beginPath()
        d.arc(8, 8, 6.3, 0, Math.PI * 2, false)
        d.stroke()
        d.beginPath()
        d.arc(8, 8.4, 3.4, 0.2 * Math.PI, 0.8 * Math.PI, false)
        d.stroke()
        d.beginPath(); d.arc(5.9, 6.4, 0.85, 0, Math.PI * 2, false); d.fill()
        d.beginPath(); d.arc(10.1, 6.4, 0.85, 0, Math.PI * 2, false); d.fill()
        }
    ]


/*
## What opens over the conversation

The reaction marks, offered above the message they are for; the service's
photographs, to send one; and a photograph at its full size, on black, until
a press or Esc puts it away.
*/

class EmojiKey extends Control [ width = 44, height = 44, cornerRadius = 22,
    emoji: string = "",
    chosen() { },
    fill = { pressed ? provided("theme").controlPressed : hovered ? provided("theme").control : null },
    scale = { pressed ? 1.18 : 1 },
    pivotX = 22, pivotY = 22,
    Text [ x = center, y = center, fontSize = 25, text = { classroot.emoji } ],
    press() { this.chosen() }
    ]


class SendableTile extends Control [ cornerRadius = 10, clip = true,
    src: string = "",
    alt: string = "",
    side: number = 96,
    width = { side }, height = { side },
    fill = { provided("theme").photoWell },
    tooltipLabel = { alt },
    Image [ width = 100%, height = 100%, stretches = cover, source = { app.media(classroot.src) } ],
    View [ width = 100%, height = 100%, fill = #000000, opacity = { classroot.pressed ? 0.18 : 0 } ]
    ]


class PhotoViewer extends Dialog [ presentation = "full",
    src: string = "",
    alt: string = "",
    theme = { { ...provided("theme"), surface: 0x0C0B0A } },

    stage: View [ width = 100%, height = { classroot.hostH },
        onClick() { classroot.close() },
        pad: number = { app.phone ? 0 : 40 },
        room: number = { this.height - this.pad * 2 - 64 },
        pic: Image [ stretches = contain, source = { app.media(classroot.src) },
            x = { parent.pad }, y = { parent.pad + 16 },
            width = { parent.width - parent.pad * 2 }, height = { parent.room } ],
        caption: Text [ x = center, y = { parent.height - parent.pad - 36 }, maxLines = 1,
            width = { Math.min(this.contentWidth, parent.width - 48) },
            fontSize = 14, textColor = #CFC8BD, text = { classroot.alt } ],
        shut: Control [ x = { parent.width - 56 }, y = { 12 + app.safeTop }, width = 44, height = 44, cornerRadius = 22,
            fill = { this.pressed ? 0x3A3631 : 0x24211E },
            tooltipLabel = "Close",
            CloseIcon [ x = center, y = center, iconSize = 18, ink = #EEE9E0 ],
            press() { classroot.close() }
            ]
        ]
    ]
