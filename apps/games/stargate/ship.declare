/*
## The ship

How the ship flies and turns, what its buttons do, its flame, and its laser. A button is
pressed when it is down after two readings up. A press waits in one of four places for a
pass to make a turn of it: the first free, or else the last, over what was there.
*/

class Pilot extends Rules [ kinds = ["laser", "turn", "flame"],

    held: Controls = { { up: false, down: false, thrust: false, reverse: false, fire: false,
        smartBomb: false, hyperspace: false, inviso: false } },
    downLast: string[] = [],
    downBefore: string[] = [],
    waiting: string[] = ["", "", "", ""],       // the presses waiting, in their places ("" for none)
    turning: boolean = false,           // a turn round is under way
    beams: number = 0,                  // lasers in flight, at most four
    invisible: boolean = false,         // the ship has its inviso on

    clear() { waiting = ["", "", "", ""]; turning = false; beams = 0 },

    freshShip() -> Ship {
        return { x: 64, y: 128, speed: 0, climb: 0, facing: 1, turnTo: 1, px: 64, py: 128, nextPy: 128, flame: [],
            planetX: game.wrapX(64 + game.scroll) }
        },

    readButtons(c: Controls) {
        held = c
        const down = ["fire", "smartBomb", "hyperspace", "reverse"].filter((name) => c[name])
        const pressed = down.filter((name) => !downLast.includes(name) && !downBefore.includes(name))
        downBefore = downLast; downLast = down
        const places = waiting.slice()
        for (const name of pressed) { const free = places.indexOf(""); places[free < 0 ? 3 : free] = name }
        waiting = places
        },

    // A pass takes the presses in the first two places, or, with those empty, the one in the
    // third, or else the fourth. Each becomes a turn, unless the ship is out of action; the
    // last made goes first.

    takePresses() {
        const places = waiting.slice()
        const from = places[0] != "" || places[1] != "" ? [0, 1] : places[2] != "" ? [2] : [3]
        const taken = from.map((i) => places[i]).filter((p) => p != "")
        for (const i of from) places[i] = ""
        waiting = places
        const out = game.gameOver || game.controlsOff || game.frozen || game.shipDead
        if (held.inviso && !out && !invisible) game.begin("inviso", "on")
        if (out) return
        for (const p of taken) {
            if (p == "fire") game.begin("laser", "fire")
            else if (p == "smartBomb") game.begin("smart bomb", "setOff")
            else if (p == "hyperspace") game.begin("hyperspace", "jump")
            else game.begin("turn", "reverse")
            }
        },

    // ── flying ──

    // The planet moves under the ship by its speed, to the 32nd of a pixel below it. Drag
    // takes a 64th of that each frame, and thrust adds three 32nds, to a top speed of eight
    // pixels a frame. The ship rides a quarter of the way in from the edge behind it, a pixel
    // further forward for each eighth of a pixel a frame it goes; when it turns, the planet
    // slides under it two pixels a frame until it is in place on the other side.

    thrust: number = { 3 / 32 },
    pace(ship: Ship) -> number { return Math.floor(ship.speed * 32) / 32 },
    fly(ship: Ship) {
        if (game.controlsOff) return
        ship.speed = ship.speed - this.pace(ship) / 64
        if (held.thrust) ship.speed = ship.speed + ship.facing * thrust
        const lead = Math.floor(ship.speed * 8)
        const home = (ship.facing > 0 ? 64 : 224) + (lead * ship.facing >= 0 ? lead : 0)
        let slide = 0
        if (home - ship.x > 2) { slide = 2; ship.x = ship.x + 2 }
        else if (home - ship.x <= -2) { slide = -2; ship.x = ship.x - 2 }
        else ship.x = home
        const fraction = ship.speed - this.pace(ship)          // (kept when the speed is capped)
        ship.speed = Math.max(fraction - 8, Math.min(fraction + 8, ship.speed))
        game.lastScroll = game.scroll
        game.scroll = game.wrapX(game.scroll + this.pace(ship) - slide)
        ship.planetX = game.wrapX(Math.floor(ship.x) + game.scroll)
        this.climb(ship)
        },

    // Up and down start at a pixel a frame and gather speed, a 32nd at a time, to two; letting
    // go stops the ship dead. It cannot leave the playfield.

    climb(ship: Ship) {
        if (held.up) {
            if (ship.y < game.top + 2) return
            ship.climb = ship.climb < 0 ? Math.max(ship.climb - 1 / 32, -2) : -1
            }
        else if (held.down) {
            if (ship.y >= 238) return
            ship.climb = ship.climb > 0 ? Math.min(ship.climb + 1 / 32, 2) : 1
            }
        else ship.climb = 0
        ship.y = ship.y + ship.climb
        ship.nextPy = Math.floor(ship.y)
        },

    // The ship is redrawn when the band of the screen it was last drawn in is drawn, and only
    // then does a turn round show. Its flame is twelve pairs of pixels read from a table of
    // random colors — five while the engine idles — from a place that moves on, so it
    // flickers.

    flame: number[] = [],
    flameAt: number = 0,
    newFlameTable() {
        const flames = []
        for (let i = 0; i < 32; i++) flames.push(game.chance.draw())
        flame = flames; flameAt = 0
        },
    drawShip(above: number, below: number) {
        const ship = game.world.ship, wasPx = ship.px, wasPy = ship.py
        if (!game.shipHidden && (wasPy < above || wasPy >= below)) return
        ship.facing = ship.turnTo
        ship.px = Math.floor(ship.x); ship.py = ship.nextPy
        if (game.shipHidden) return
        game.shipShown = true
        game.rubOut(wasPx - 8, wasPy, 16, 6)
        game.rubOut(ship.px - 8, ship.py, 16, 6)
        const read = ship.facing > 0 ? [0, 1, 5, 9, 12, 3, 6, 10, 4, 7, 11, 8] : [0, 1, 2, 3, 4, 5, 6, 7, 10, 11, 8, 9]
        ship.flame = read.map((k, i) => i < 5 || held.thrust ? flame[(flameAt + k) % 32] : 0)
        },
    shipPicture(ship: Ship) -> string { return ship.facing > 0 ? "ship-right" : "ship-left" },

    // Once a pass: has the ship run into anything, or been hit by a shot?

    touchShip() {
        if (game.shipDead || game.standby) return
        const ship = game.world.ship, picture = this.shipPicture(ship)
        if (game.touch(ship.px, ship.py, picture, true)
            || game.shooters.touch(ship.px, ship.py, picture)) game.director.shipHit()
        },

    // ── turns ──

    // The flame's place in its table moves on every fourth pass.

    flicker(t: Turn) { flameAt = flameAt + 1 > 32 ? 0 : flameAt + 1; t.wait = 4 },

    // Turning round: the ship faces the other way when next drawn. A new turn waits until
    // the button has been up for five passes.

    reverse(t: Turn) {
        if (turning) { game.end(t); return }
        turning = true
        game.world.ship.turnTo = -game.world.ship.facing
        this.rest(t, 2, "reverseHeld")
        },
    reverseHeld(t: Turn) { this.rest(t, held.reverse ? 2 : 5, held.reverse ? "reverseHeld" : "reversed") },
    reversed(t: Turn) { turning = false; game.end(t) },

    // ── the laser ──

    // A beam grows from the ship's nose eight pixels a pass, in the row it was fired from,
    // its tail following two pixels a pass and its middle ragged. It stops at the edge of
    // the screen or at the first thing it touches. (Its head, middle and tail are counted
    // in pairs of pixels, which is how the arcade draws it.)

    fizzle: number[][] = [],            // the ragged middle: 32 random pairs of pixels' inks, each lit or dark
    fizzleAt: number = 0,
    newLaserTable() {
        const ragged = []
        const lit = (on: number) => on * game.ink.laser
        for (let i = 0; i < 32; i++) { const r = game.chance.draw(); ragged.push([lit(Math.floor(r / 2) % 2), lit(r % 2)]) }
        fizzle = ragged; fizzleAt = 0
        },
    fire(t: Turn) {
        if (game.spectacle || beams >= 4) { game.end(t); return }
        beams = beams + 1
        game.sound("laser")
        const ship = game.world.ship, nose = Math.floor(Math.floor(ship.x) / 2) + (ship.turnTo > 0 ? 7 : 0)
        t.beam = { row: Math.floor(ship.y) + 4, way: ship.turnTo > 0 ? 1 : -1, head: nose, fizz: nose, tail: nose }
        this.beam(t)
        },
    beam(t: Turn) {
        t.step = "beam"
        const b = t.beam!, way = b.way, row = b.row, laser = game.ink.laser, white = game.ink.marks
        const spent = game.controlsOff || (way > 0 ? b.head >= 152 : b.head < 5)
        if (!spent) {
            for (let k = 0; k < 4; k++) this.mark(row, b.head + way * k, laser, laser)
            b.head = b.head + 4 * way
            this.mark(row, b.head, white, white)
            if (fizzleAt >= 29) fizzleAt = 0
            const ragged = [fizzle[fizzleAt], fizzle[fizzleAt + 1], fizzle[fizzleAt + (way > 0 ? 2 : 1)]]
            ragged.forEach((inks, k) => this.mark(row, b.fizz + k * way, inks[0], inks[1]))
            fizzleAt = fizzleAt + (way > 0 ? 3 : 2)
            b.fizz = b.fizz + 3 * way
            this.mark(row, b.tail, 0, 0)
            b.tail = b.tail + way
            if (!game.touch(2 * (way > 0 ? b.head - 6 : b.head), row, "laser", false)) { t.wait = 1; return }
            }
        for (let p = b.tail; way > 0 ? p <= b.head : p >= b.head; p += way) this.mark(row, p, 0, 0)
        game.world.trails = game.world.trails.filter((trail) => trail.inks.some((ink) => ink != 0))
        beams = beams - 1
        game.end(t)
        },

    // What beams leave on a row of the screen: each pair of pixels' inks.

    mark(row: number, pair: number, left: number, right: number) {
        if (pair < 0 || pair >= 160) return
        let trail = game.world.trails.find((t) => t.id == row)
        if (trail == null) {
            if (left == 0 && right == 0) return
            trail = { id: row, inks: new Array(320).fill(0) }
            game.world.trails.push(trail)
            }
        trail.inks[2 * pair] = left
        trail.inks[2 * pair + 1] = right
        }
    ]
