/*
## The set pieces

The planet blowing up when its last man is lost, and the warp that takes a ship carrying four
men or more through the star gate, three waves on.

Each is a firework of blocks, two pixels wide and two high, thrown across a cleared screen
for a few seconds. The blocks are records in the world (`shards`). A turn of the set piece
walks through them in order and moves each once: it is rubbed out where it was and drawn
where it now is, or it is gone if it has left the screen, and the last block takes its place
in the walk. Between walks the set piece counts down to its next ring or burst, and flashes
the background. It draws random numbers of its own (`roll`), and leaves the game's alone.
While either runs nothing appears or explodes, no laser fires, and the star gate takes no one.

    blast   wait → blow → blowing …         (or lookAgain … while the ship is busy)
    warp    begin → warping …               (then the director's bonus)
*/

// A block: where it is and its speed, as the arcade keeps them — in 256ths of a pair of pixels
// across and of a pixel down, its numbers coming straight from the set piece's random bytes;
// how its speed grows (the warp's only); its ink; and where it is drawn, and was.

schema Shard [ x: number, y: number, vx: number, vy: number, ax: number, ay: number, ink: number,
    px: number, py: number, moved: boolean, wasPx: number, wasPy: number ]

// A block that left the screen in the last walk: where it was, and its place in the walk.

schema Lost [ slot: number, px: number, py: number ]

class SetPieces extends Rules [ kinds = ["blast", "warp"],

    kind: string = "",                  // "blast" or "warp" while one is under way
    seed: number = 0,                   // its random generator's two bytes
    next: number = 0,                   // walks to the next ring or burst
    left: number = 0,                   // rings or bursts still to come
    pace: number = 0,                   // the warp: walks between flashes; the planet's end: a count to its next flash
    flashIn: number = 0,                // the warp: walks to its next flash
    ink: number = 0,                    // the color of the last ring or burst, less one
    asked: number = 0,                  // the background asked for at the next frame, or 0
    saved: number[] = [],               // the warp: inks 1 to 8 as they were before it
    flashing: boolean = false,          // the background flashes and fades a step each frame
    topShown: boolean = true,           // the top of the screen is drawn; cleared with the screen till a set piece ends

    // ── the screen ──

    // The whole screen is cleared, the top with the playfield; the top is drawn again later,
    // its strip saying "SCANNER" and the scanner empty.

    clearScreen() {
        game.wipe()
        topShown = false
        game.world.scan = { blips: [], ground: -1, shipPx: 0, shipPy: 0 }
        },
    drawTop() {
        topShown = true
        game.messages.clearStrip()
        game.world.scan = { blips: [], ground: -1, shipPx: 0, shipPy: 0 }
        },

    // ── the blocks ──

    // The set piece's own random numbers: two bytes. At each draw the high byte becomes the
    // low one shifted down a place, with the high byte's last bit coming in at the top; the
    // low byte gets its own last bit at the top, and below it seven bits each saying whether
    // that bit of the high byte differs from the one beneath it. A draw gives the new low byte.

    roll() -> number {
        const high = Math.floor(seed / 256), low = seed % 256
        let differs = 0
        for (let k = 0; k < 7; k++) {
            const bit = Math.floor(high / 2 ** k) % 2, beneath = k == 0 ? 0 : Math.floor(high / 2 ** (k - 1)) % 2
            if (bit != beneath) differs = differs + 2 ** k
            }
        seed = ((high % 2) * 128 + Math.floor(low / 2)) * 256 + (low % 2) * 128 + differs
        return seed % 256
        },

    // Every block moves once, in order. One that would leave the screen — the rows above 10 or
    // from 246 down, the pairs of pixels from 156 across — is rubbed out and gone, and the last
    // block takes its place in the walk.

    walk() {
        const w = game.world
        w.lost = []
        for (let k = 0; k < w.shards.length;) {
            const s = w.shards[k], wasPx = s.px, wasPy = s.py
            s.vy = word(s.vy + s.ay)
            const y = word(s.y + s.vy), row = Math.floor(y / 256)
            let gone = row >= 246 || row < 10
            if (!gone) {
                s.y = y
                s.vx = word(s.vx + s.ax)
                const x = word(s.x + s.vx), pair = Math.floor(x / 256)
                gone = pair >= 156
                if (!gone) { s.x = x; s.px = 2 * pair; s.py = row; s.wasPx = wasPx; s.wasPy = wasPy; s.moved = true; k++ }
                }
            if (!gone) continue
            w.lost.push({ slot: k, px: wasPx, py: wasPy })
            const last = w.shards.pop()!
            if (k < w.shards.length) w.shards[k] = last
            }
        },
    block(column: number, row: number, vx: number, vy: number, ax: number, ay: number, ink: number) -> Shard {
        return { x: column * 256 + row, y: row * 256, vx: word(vx), vy: word(vy), ax: word(ax), ay: word(ay), ink: ink,
            px: 2 * column, py: row, moved: false, wasPx: 0, wasPy: 0 }
        },

    // Each frame, as the picture starts, the background takes the color asked for, or else
    // fades a step.

    flashBackground() {
        const c = game.palette[game.ink.background]
        game.paint(game.ink.background, asked != 0 ? asked
            : c - (game.blueOf(c) > 0 ? 64 : 0) - (game.greenOf(c) > 0 ? 8 : 0) - (game.redOf(c) > 0 ? 1 : 0))
        asked = 0
        },
    flashColors: number[] = { game.cycles.laserColors.slice(0, 32) },

    // ── the planet's end ──

    // When the last man is lost a turn is made to blow the planet up. It waits until no
    // hyperspace, star gate trip or ship's death is under way. Then the planet is gone and
    // nothing appears or explodes; every shot goes, though the count of shots stays as it
    // was; and everything else sleeps for 192 passes.

    busy() -> boolean { return game.controlsOff || game.frozen || game.shipHidden || game.effectsOff },
    wait(t: Turn) {
        if (this.busy()) { this.rest(t, 4, "lookAgain"); return }
        game.halt([...game.halted(), "effects", "planet"])
        game.shooters.dropAll()
        game.sleepAll(192)
        this.rest(t, 1, "blow")
        },
    lookAgain(t: Turn) { this.rest(t, 4, this.busy() ? "lookAgain" : "wait") },

    // Everything near the screen goes far, the screen is cleared, and the ground breaks up.

    blow(t: Turn) {
        const w = game.world
        game.clock.changing(w)
        w.far = [...w.far, ...w.near]; w.near = []
        game.clock.changing(w)
        this.clearScreen()
        game.spectacle = true
        this.breakGround()
        game.clock.changing(w)
        if (this.blastCount()) this.rest(t, 1, "blowing")
        else this.blowing(t)
        },

    // The ground as last drawn breaks into a block for each of its 154 pairs of pixels across
    // the screen — its row standing also as the fraction of its pair — in runs of two to nine
    // blocks that rise at one speed and spread at another. The background now flashes, and
    // the ground's ink is white.
    //
    // A block's fraction of a row is what the arcade's memory last held there: past the 99th
    // block that is a copy of the ground's heights; before it, it is what appearing and
    // exploding effects left behind, which the game does not keep, and is taken as 0.

    breakGround() {
        const w = game.world, rows = game.scenery.rows
        flashing = true
        kind = "blast"; seed = game.chance.second * 256 + game.chance.third; ink = 0; left = 16; next = 48; pace = 1; asked = 0
        game.paint(game.ink.ground, game.white)
        const at = Math.floor(game.groundAt)
        let run = 0, vx = 0, vy = 0
        w.shards = []; w.lost = []
        for (let k = 0; k < 154; k++) {
            if (run == 0) {
                run = Math.floor(seed / 256) % 8 + 2
                const up = Math.floor((this.roll() % 128 - 128) / 2)
                vy = word(up - 128)
                vx = word(2 * signed8(this.roll()))
                game.memory.firstEffectWord = vy
                }
            run = run - 1
            const row = k < 2 || k >= 150 ? 0 : Math.min(rows[(at + 2 * k) % 2048], rows[(at + 2 * k + 1) % 2048])
            const stale = 10 * k - 993
            const fraction = stale < 0 ? game.memory.leftInEffects(31 + 10 * k) : stale == 0 ? 224 : rows[2 * stale - 1]
            const s = this.block(k, row, vx, vy, 0, 0, game.ink.ground)
            s.y = row * 256 + fraction
            w.shards.push(s)
            }
        },

    // While ten blocks or more are left, every block moves and the count goes on, and again
    // at once if a burst was made.

    blowing(t: Turn) {
        t.step = "blowing"
        for (;;) {
            game.clock.overloaded()
            if (game.world.shards.length < 10) { this.blastOver(t); return }
            this.walk()
            game.clock.changing(game.world)
            if (this.blastCount()) { this.rest(t, 1, "blowing"); return }
            }
        },

    // For its first 48 walks the pieces of ground speed up, doubling their speed three times,
    // and every third walk the background flashes a random color with a tick of sound. Then
    // come sixteen bursts; true if there is none this time.

    blastCount() -> boolean {
        if (left == 16) {
            if (next == 32 || next == 16 || next == 1)
                for (const s of game.world.shards) { s.vx = word(2 * s.vx); s.vy = word(2 * s.vy) }
            pace = pace - 1
            if (pace == 0) { pace = 3; game.sound("warp tick"); asked = flashColors[this.roll() % 32] }
            }
        next = countDown(next)
        if (next != 0) return true
        this.burst()
        return false
        },

    // A burst: up to 88 blocks from a random place, in one of the eight colors in turn,
    // flying out in a diamond more or less ragged, with a random sound and a flash. Bursts
    // come two to nine walks apart, the last five four apart. There are 399 blocks at most.

    burstSpreads: number[] = [8, 2, 4, 1, 4, 4, 2, 8],         // how ragged each of the eight shapes is
    burstSounds: string[] = ["warp mutant hit", "warp man hit", "warp lander hit", "warp laser", "warp tick", "warp man hit"],
    burst() {
        const w = game.world
        next = Math.floor(seed / 256) % 8 + 2
        if (left == 0) return
        if (16 - left > 10) next = 4
        left = left - 1
        ink = (ink + 1) % 8
        let pick = Math.floor(this.roll() % 16 / 2)
        while (pick >= 6) pick = Math.floor(this.roll() % 16 / 2)
        game.sound(burstSounds[pick])
        asked = flashColors[Math.floor(seed / 256) % 32]
        if (w.shards.length >= 399) return
        const ragged = burstSpreads[this.roll() % 8]
        let column = 0, row = 0
        do { this.roll(); column = Math.floor(seed / 256); row = seed % 256 } while (column >= 156 || row <= 10 || row >= 246)
        for (let i = 0; i < 2048 && w.shards.length < 399; i += 96)
            for (const way of [[1, 1], [1, -1], [-1, 1], [-1, -1]]) {
                const s = this.block(column, row, way[1] * this.spread(i, ragged), way[0] * i, 0, 0, ink + 1)
                s.y = row * 256 + row
                w.shards.push(s)
                }
        },

    // How fast a burst's block flies across: less the further up or down it flies.

    spread(i: number, ragged: number) -> number {
        const r = this.roll(), across = r >= 128 ? (r % ragged - ragged) * 256 + 255 : r % ragged * 256
        return word(Math.floor((across - i + 2048) / 2))
        },

    // The background black again, and the screen cleared. The top is drawn again; things
    // that were near the screen are thrown half way round the planet, the star gate apart;
    // and things appear and explode once more. The planet stays gone.

    blastOver(t: Turn) {
        const w = game.world
        flashing = false
        game.paint(game.ink.background, game.black)
        kind = ""
        game.endSpectacle()
        this.clearScreen()
        this.drawTop()
        const screenAt = game.scroll
        for (const o of [...w.far, ...w.near])
            if (game.near(o.x, screenAt) && o.kind != "gate") o.x = game.wrapX(o.x + 1024)
        game.sendFar()
        game.halt(game.halted().filter((h) => h != "effects"))
        game.end(t)
        },

    // ── the warp ──

    // The ship has flown into the gate with four men or more. Every other turn ends, the
    // screen is cleared and the wave is kept; at the next pass the warp begins.

    warp(t: Turn) {
        game.clock.endAll(game.world, [t])
        this.clearScreen()
        game.director.save()
        t.kind = "warp"                     // (the gate's process goes on as the warp, and after it as the director's)
        this.rest(t, 1, "begin")
        },

    // Rings of 64 blocks fly out from the middle of the screen, spreading faster as they go:
    // one to begin, and seven more, a walk in nine. The first eight inks are the warp's own
    // while it lasts, a ring in each, and the background flashes green, white or red, more
    // often as the rings come. Its random numbers start from what the first effect's place in
    // memory last held.

    ringColors: number[] = { [rgb(7, 7, 3), rgb(7, 7, 0), rgb(0, 7, 3), rgb(7, 0, 0), rgb(7, 7, 3), rgb(0, 7, 0), rgb(7, 0, 3), rgb(0, 0, 3)] },
    begin(t: Turn) {
        const w = game.world
        game.spectacle = true
        kind = "warp"
        saved = game.palette.slice(1, 9)
        ringColors.forEach((c, i) => game.paint(1 + i, c))
        game.sound("warp")
        seed = word(game.memory.firstEffectWord + 13398)
        ink = 0; left = 7; next = 9; pace = 7; flashIn = 1
        w.shards = []; w.lost = []
        this.ring()
        game.clock.changing(w)
        if (this.warpCount()) { this.rest(t, 2, "warping"); return }
        this.warping(t)
        },
    warping(t: Turn) {
        for (;;) {
            if (game.world.shards.length == 0) { this.warped(t); return }
            this.walk()
            game.clock.changing(game.world)
            if (this.warpCount()) { this.rest(t, 2, "warping"); return }
            }
        },

    // After each walk: the background flashes or goes black, and every ninth walk the flashes
    // come quicker and a ring is added; true if there is none this time.

    warpCount() -> boolean {
        flashIn = flashIn - 1
        let color = 0
        if (flashIn == 0) { flashIn = pace; color = ringColors[pace - 2] }
        game.paint(game.ink.background, color)
        next = next - 1
        if (next != 0) return true
        if (pace > 5) pace = pace - 1
        next = 9
        if (left == 0) return false
        left = left - 1
        ink = ink + 1
        this.ring()
        return false
        },

    // A ring: from the middle of the screen, four blocks for each of sixteen ways up or down,
    // each spreading left or right at random, less the steeper it goes.

    ring() {
        for (let i = 0; i < 320; i += 20)
            for (const way of [[1, 1], [1, -1], [-1, 1], [-1, -1]]) {
                const r = this.roll(), across = r >= 128 ? r % 64 - 64 : r % 64
                const s = this.block(80, 128, 0, 0, way[1] * Math.floor((across - i + 320) / 2), way[0] * i, ink + 1)
                s.x = 80 * 256                  // (from the middle pair, its fraction left at nothing)
                game.world.shards.push(s)
                }
        },

    // The warp over: the inks as they were, and effects free to run. The top of the screen is
    // drawn again, the wave goes two on — the men come back if a fifth wave is passed — and
    // the number of the wave it has come to is lettered; then the bonus is paid for each man
    // on the planet, 2,000 apiece, as the third wave comes on, and the next ship starts.

    warped(t: Turn) {
        game.paint(game.ink.background, game.black)
        saved.forEach((c, i) => game.paint(1 + i, c))
        game.memory.firstEffectWord = seed
        kind = ""
        game.endSpectacle()
        game.cycles.restart()
        this.drawTop()
        game.director.advanceWave(); game.director.advanceWave()
        game.messages.show("warp", game.director.wave + 1)
        t.kind = "director"
        t.after = "nextShip"
        game.director.payMen(t, 20)
        }
    ]
