/*
## Colors that change

Four turns keep colors on the move: the laser's runs through thirty-six, the bombs flash
white and then take one of the laser's at random, the bombers' three change places, and
the ground and the star gate's rings take theirs from where on the planet the screen is.
*/

class Cycles extends Rules [ kinds = ["laser color", "shot color", "bomber color", "ground color"],

    // The three that start again after a ship's end, a wave's or a warp.

    restart() {
        game.begin("laser color", "firstLaser")
        game.begin("shot color", "flash")
        game.begin("bomber color", "bombers")
        },

    // The laser's color changes every other pass. Every laser-color turn moves the same place
    // in the list on, and a new turn starts it from the top: two at once (as the end of the
    // demonstration leaves) run through it twice as fast.

    laserColors: number[] = { [rgb(0, 7, 0), rgb(1, 7, 0), rgb(2, 7, 0), rgb(3, 7, 0), rgb(4, 7, 0), rgb(5, 7, 0), rgb(6, 7, 0), rgb(7, 7, 0), rgb(7, 6, 0), rgb(7, 5, 0), rgb(7, 4, 0), rgb(7, 3, 0), rgb(7, 2, 0),
        rgb(7, 0, 1), rgb(7, 0, 1), rgb(7, 0, 2), rgb(7, 0, 2), rgb(7, 0, 3), rgb(7, 0, 3), rgb(6, 0, 3), rgb(5, 0, 3), rgb(4, 1, 3), rgb(3, 1, 3), rgb(2, 1, 3), rgb(2, 3, 3), rgb(0, 5, 3), rgb(0, 7, 3), rgb(1, 7, 3), rgb(2, 7, 3), rgb(3, 7, 3), rgb(5, 7, 3), rgb(7, 7, 3),
        rgb(7, 7, 2), rgb(7, 7, 0), rgb(6, 7, 0), rgb(4, 7, 0)] },
    laserAt: number = 0,
    firstLaser(t: Turn) { laserAt = 0; this.laser(t) },
    laser(t: Turn) {
        if (laserAt == 36) laserAt = 0
        game.paint(game.ink.laser, laserColors[laserAt])
        laserAt = laserAt + 1
        this.rest(t, 2, "laser")
        },

    // Bombs flash white for three passes in nine; and their picture changes.

    flash(t: Turn) {
        game.paint(game.ink.bombs, game.white); game.paint(game.ink.bombCenters, game.black)
        this.rest(t, 3, "tint")
        },
    tint(t: Turn) {
        const tint = laserColors[game.chance.last % 32]
        game.paint(game.ink.bombs, tint); game.paint(game.ink.bombCenters, tint)
        game.shooters.look = game.shooters.look == 1 ? 2 : 1
        this.rest(t, 6, "flash")
        },

    // The bombers' three colors change places every six passes.

    bomberColors: number[] = { [rgb(1, 0, 2), rgb(1, 0, 2), rgb(7, 5, 0), rgb(1, 0, 2), rgb(7, 5, 0), rgb(7, 0, 0), rgb(7, 5, 0), rgb(1, 0, 2), rgb(7, 0, 0)] },
    bombers(t: Turn) {
        if (t.count == null) { t.count = 0; this.rest(t, 6, "bombers"); return }
        for (let i = 0; i < 3; i++) game.paint(game.ink.bombers + i, bomberColors[3 * t.count + i])
        t.count = (t.count + 1) % 3
        t.wait = 6
        },

    // The ground's color, by the thirty-second of the planet the screen is in; the gate's
    // rings by the sixteenth, one of the three in turn in the bombs' color.

    groundColors: number[] = { [rgb(7, 0, 3), rgb(7, 0, 3), rgb(7, 0, 3), rgb(7, 0, 3), rgb(7, 0, 3), rgb(7, 0, 3), rgb(7, 0, 2), rgb(7, 0, 1), rgb(7, 0, 1), rgb(7, 0, 0), rgb(7, 0, 0), rgb(7, 0, 0), rgb(7, 0, 0), rgb(7, 0, 0), rgb(7, 0, 0), rgb(7, 0, 0),
        rgb(7, 0, 0), rgb(7, 0, 0), rgb(7, 1, 0), rgb(7, 3, 0), rgb(7, 2, 0), rgb(7, 2, 0), rgb(7, 2, 0), rgb(7, 2, 0), rgb(7, 2, 0), rgb(7, 2, 0), rgb(7, 2, 0), rgb(7, 2, 0), rgb(7, 2, 0), rgb(7, 2, 1), rgb(7, 2, 2), rgb(7, 0, 2)] },
    gateColors: number[] = [2, 11, 11, 11, 11, 11, 8, 8, 8, 8, 8, 8, 2, 2, 2, 2],
    ground(t: Turn) {
        const where = Math.floor(game.scroll / 64)
        game.paint(game.ink.ground, groundColors[where])
        t.count = ((t.count ?? 2) + 1) % 3
        const ring = gateColors[Math.floor(where / 2)]
        game.gates.rings = [0, 1, 2].map((i) => i == t.count ? game.ink.bombs : ring)
        t.wait = 4
        }
    ]
