use [ PlusIcon, MinusIcon ]

App [ width = 360, height = 100,
    bold: boolean = false,
    italic: boolean = false,
    Toolbar [ x = 20, y = 20, accessibilityLabel = "Formatting",
        ToolButton [ label = "B", toggle = true, on = { app.bold },
            input(v: boolean) { app.bold = v },
            accessibilityLabel = "Bold"
            ],
        ToolButton [ label = "I", toggle = true, on = { app.italic },
            input(v: boolean) { app.italic = v },
            accessibilityLabel = "Italic"
            ],
        ToolbarDivider [ ],
        ToolButton [ icon = "PlusIcon", label = "Add" ],
        ToolButton [ icon = "MinusIcon", label = "Remove" ]
        ]
    ]
