// TextSizeSwitch, driving a page's reading size
// The app keeps the scale its text reads at; the switch shows it and hands a pick back.

App [ width = 360, height = 140, fill = white, textColor = 0x172530,
    readScale: number = 1,
    col: View [ x = 20, y = 20, width = 320,
        layout: SimpleLayout [ axis = y, spacing = 14 ],
        TextSizeSwitch [ value = { app.readScale },
            input(v: object) { app.readScale = v as number }
            ],
        Text [ width = 100%, wrap = true, fontSize = { 15 * app.readScale }, text = "The page reads at the size you pick." ]
        ]
    ]
