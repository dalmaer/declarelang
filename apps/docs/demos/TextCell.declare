// Built by the grid, never written
// A `TextCell` shows its value as a label — the Owner column, whose `kind` is the default.

App [ width = 520, height = 200,
    d: Dataset { { "rows": [ { "id": 1, "task": "Write the outline", "owner": "Ada", "state": "open", "done": true },
                           { "id": 2, "task": "Review the draft", "owner": "Lin", "state": "review", "done": false },
                           { "id": 3, "task": "Send it out", "owner": "Sam", "state": "open", "done": false } ] } },
    DataGrid [ x = 20, y = 20, width = 480, height = 140, datapath = { d.value },
        Column [ title = "Task", field = "task", kind = "edit", width = 200 ],
        Column [ title = "Owner", field = "owner", width = 90 ],
        Column [ title = "State", field = "state", kind = "select", options = { ["open", "review", "closed"] }, width = 110 ],
        Column [ title = "Done", field = "done", kind = "check", width = 60 ],
        GridRow [ datapath = :rows[] ]
        ]
    ]
